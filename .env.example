# MeghDrishti Environment Configuration
# Copy this file to .env and insert your API credentials

# Google Gemini API (Required for natural language understanding & responses)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenWeatherMap API (Required for real-time and forecast weather data)
OPENWEATHERMAP_API_KEY=

# ElevenLabs API (Required for voice synthesis / text-to-speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# App / Server Settings (Railway injects PORT automatically)
PORT=8000
APP_HOST=0.0.0.0
DEBUG=false

# Cache TTL (seconds)
WEATHER_CACHE_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_VOICE=10/minute
RATE_LIMIT_WEATHER=30/minute
